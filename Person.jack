class Person{
   field int x, y;
   field int size;

   constructor Person new(int initialX, int initialY){
      let x = initialX;
      let y = initialY;

      let size = Constant.SPRITE_SIZE();

      do draw();

      return this;
   }

   method void dispose(){
      do Memory.deAlloc(this);
      return;
   }

   method void draw(){
      do drawSprite(y * Constant.SCREEN_WIDTH_IN_WORDS() + (x / size));
      return;
   }

   method void erase() {
      do Screen.setColor(false);
      do Screen.drawRectangle(x, y, x + size - 1, y + size - 1);
      return;
   }

   method void drawSprite(int screenOffset) {
      var int spriteAddress; 
      let spriteAddress = Constant.SCREEN_MEMORY_START() + screenOffset;

      do Memory.poke(spriteAddress, 4080);
      do Memory.poke(spriteAddress +32, 16380);
      do Memory.poke(spriteAddress +64, 26598);
      do Memory.poke(spriteAddress +96, 24570);
      do Memory.poke(spriteAddress +128, -3121);
      do Memory.poke(spriteAddress +160, -7801);
      do Memory.poke(spriteAddress +192, -7801);
      do Memory.poke(spriteAddress +224, -3121);
      do Memory.poke(spriteAddress +256, -1);
      do Memory.poke(spriteAddress +288, -961);
      do Memory.poke(spriteAddress +320, -961);
      do Memory.poke(spriteAddress +352, -961);
      do Memory.poke(spriteAddress +384, 31806);
      do Memory.poke(spriteAddress +416, 31806);
      do Memory.poke(spriteAddress +448, 15996);
      do Memory.poke(spriteAddress +480, 4080);
      
      return;
   }

   method void move(int dx, int dy) {
      if (~Collision.checkCollisionWall(x + dx, y + dy)) {
         do erase();

         let x = x + dx;
         let y = y + dy;

         do draw();
      }
      return;
   }

   method void moveUp() {
      do move(0, -Constant.MOVEMENT_STEP());
      return;
   }

   method void moveDown() {
      do move(0, Constant.MOVEMENT_STEP());
      return;
   }

   method void moveLeft() {
      do move(-Constant.MOVEMENT_STEP(), 0);
      return;
   }

   method void moveRight() {
      do move(Constant.MOVEMENT_STEP(), 0);
      return;
   }

   method int getLeft(){
      return x;
   }

   method int getRight(){
      return x + size - 1;
   }

   method int getTop(){
      return y;
   }

   method int getBottom(){
      return y + size - 1;
   }
}