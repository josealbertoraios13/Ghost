class Person{
    field int x, y;
    field int size;
    field int memAddress;

    constructor Person new(int Ax, int Ay){
        let x = Ax;
        let y = Ay;

        let size = 16;

        let memAddress = 0;

        do draw();

        return this;
    }

    method void dispose(){
        do Memory.deAlloc(this);
        return;
    }

    method void draw(){
        do drawPerson(y*32+(x/16));
        return;
    }

    method void erase() {
        do Screen.setColor(false);
        do Screen.drawRectangle(x, y, x + size - 1, y + size - 1);
        return;
    }

   method void drawPerson(int location) {
      var int memAddress; 
      let memAddress = 16384+location;

      do Memory.poke(memAddress, 4080);
      do Memory.poke(memAddress +32, 16380);
      do Memory.poke(memAddress +64, 26598);
      do Memory.poke(memAddress +96, 24570);
      do Memory.poke(memAddress +128, -3121);
      do Memory.poke(memAddress +160, -7801);
      do Memory.poke(memAddress +192, -7801);
      do Memory.poke(memAddress +224, -3121);
      do Memory.poke(memAddress +256, -1);
      do Memory.poke(memAddress +288, -961);
      do Memory.poke(memAddress +320, -961);
      do Memory.poke(memAddress +352, -961);
      do Memory.poke(memAddress +384, 31806);
      do Memory.poke(memAddress +416, 31806);
      do Memory.poke(memAddress +448, 15996);
      do Memory.poke(memAddress +480, 4080);
      return;
   }

    method void incSize() {
      if (((y + size) < 254) & ((x + size) < 510)) {
         do erase();
         let size = size + 2;
         do draw();
      }
      return;
    }

   method void decSize() {
      if (size > 2) {
         do erase();
         let size = size - 2;
         do draw();
      }
      return;
   }

     /** Moves the ghost up by 16 pixels. */
   method void moveUp() {
      if (~checkCollisionWall(x, y - 16)) {
         do erase();
         let y = y - 16;
         do draw();
      }
      return;
   }

   /** Moves the square down by 16 pixels. */
   method void moveDown() {
      if (~checkCollisionWall(x, y + 16)) {
         do erase();
         let y = y + 16;
         do draw();
      }
      return;
   }

   /** Moves the ghost left by 16 pixels. */
   method void moveLeft() {
      if (~checkCollisionWall(x - 16, y)) {
         do erase();
         let x = x - 16;
         do draw();
      }
      return;
   }

   /** Moves the square right by 16 pixels. */
   method void moveRight() {
      if (~checkCollisionWall(x + 16, y)) {
         do erase();
         let x = x + 16;
         do draw();
      }
      return;
   }

   method boolean checkCollisionWall(int nextX, int nextY){
      var int left, right, top, bottom;

      let left = nextX / 16;
      let right = (nextX + size - 1) / 16;  
      let top = nextY / 16;
      let bottom = (nextY + size - 1) / 16;

      if(Map.isWall(left, top) | Map.isWall(right, top) | Map.isWall(left, bottom) | Map.isWall(right, bottom)){
         return true;
      }

      return false;
   }

   method int getLeft(){
      return x;
   }

   method int getRight(){
      return x + 15;
   }

   method int getTop(){
      return y;
   }

   method int getBottom(){
      return y + 15;
   }
}