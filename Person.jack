class Person{
    field int x, y;
    field int size;
    field int memAddress;

    constructor Person new(int Ax, int Ay){
        let x = Ax;
        let y = Ay;

        let size = 16;

        let memAddress = 0;

        do draw();

        return this;
    }

    method void dispose(){
        do Memory.deAlloc(this);
        return;
    }

    method void draw(){
        do drawPerson(y*32+(x/16));
        return;
    }

    method void erase() {
        do Screen.setColor(false);
        do Screen.drawRectangle(x, y, x + size, y + size);
        return;
    }

    method void drawPerson(int location) {
      var int memAddress; 
      let memAddress = 16384+location;
      // column 0
      do Memory.poke(memAddress, 4064);
      do Memory.poke(memAddress +32, 16376);
      do Memory.poke(memAddress +64, 20452);
      do Memory.poke(memAddress +96, -16390);
      do Memory.poke(memAddress +128, -6194);
      do Memory.poke(memAddress +160, -15481);
      do Memory.poke(memAddress +192, -15481);
      do Memory.poke(memAddress +224, -6193);
      do Memory.poke(memAddress +256, -1);
      do Memory.poke(memAddress +288, -1);
      do Memory.poke(memAddress +320, -897);
      do Memory.poke(memAddress +352, -1985);
      do Memory.poke(memAddress +384, -1986);
      do Memory.poke(memAddress +416, -1986);
      do Memory.poke(memAddress +448, 30780);
      do Memory.poke(memAddress +480, 15480);
      do Memory.poke(memAddress +512, 4064);
      // column 1
      do Memory.poke(memAddress +161, 1);
      do Memory.poke(memAddress +193, 1);
      do Memory.poke(memAddress +225, 1);
      do Memory.poke(memAddress +257, 1);
      do Memory.poke(memAddress +289, 1);
      do Memory.poke(memAddress +321, 1);
      do Memory.poke(memAddress +353, 1);
      return;
    }

    method void incSize() {
      if (((y + size) < 254) & ((x + size) < 510)) {
         do erase();
         let size = size + 2;
         do draw();
      }
      return;
    }

   method void decSize() {
      if (size > 2) {
         do erase();
         let size = size - 2;
         do draw();
      }
      return;
   }

   method void moveUp() {
      if (y > 15) {
         do erase();
         let y = y - 16;
         do draw();
      }
      return;
   }

   method void moveDown() {
      if ((y + size) < 256) {
         do erase();
         let y = y + 16;
         do draw();
      }
      return;
   }

   method void moveLeft() {
      if (x > 15) {
         do erase();
         let x = x - 16;
         do draw();
      }
      return;
   }

   method void moveRight() {
      if ((x + size) < 512) {
         do erase();
         let x = x + 16;
         do draw();
      }
      return;
   }

   method int getLeft(){
      return x;
   }

   method int getRight(){
      return x + 15;
   }

   method int getTop(){
      return y;
   }

   method int getBottom(){
      return y + 15;
   }
}