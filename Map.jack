>>>>>>> Stashed changes
        let rnd = Random.new(seed);
        return;
    }

    /** Libera as linhas e o gerador. Normalmente não precisa: init() reaproveita as linhas. */
    function void dispose() {
        var int i;
        var String line;
        if (built) {
            let i = 0;
            while (i < 16) {
                let line = rows[i];
                do line.dispose();
                let i = i + 1;
            }
            do rows.dispose();
            do rnd.dispose();
            let built = false;
        }
        return;
    }

    /** Verifica se a célula é parede, faz parte do painel lateral ou está fora da tela. */
    function boolean isWall(int col, int row) {
        var String line;
        if ((col < 0) | (col > 31) | (row < 0) | (row > 15)) { return true; }
        let line = rows[row];               // Jack não permite rows[row].charAt(...)
        return line.charAt(col) = 35;
    }

    /** Desenha as paredes da área de jogo (colunas 9..31). É para chamar depois de Screen.clearScreen(). */
    function void draw() {
        var int r, c;
        var String line;
        let r = 0;
        while (r < 16) {
            let line = rows[r];
            let c = 9;
            while (c < 32) {
                if (line.charAt(c) = 35) { do Map.drawWall(c, r); }
                let c = c + 1;
            }
            let r = r + 1;
        }
        return;
    }

    function void drawWall(int col, int row) {
        var int addr, i;
        let addr = 16384 + (row * 512) + col;   // 16 linhas de pixels * 32 palavras = 512 por linha de células
        let i = 0;
        while (i < 16) {
            do Memory.poke(addr + (i * 32), -1);
            let i = i + 1;
        }
        return;
    }

    /**
     * Célula livre aleatória da área de jogo (nunca parede, nunca o painel lateral),
     * codificada como linha*32 + coluna. Tem que usar colOf/rowOf/xOf/yOf para decodificar.
     */
    function int randomFreeCell() {
        var int c, r;
        // randRange(n) devolve 0..n (inclusive): colunas 9..31 e linhas 0..15
        let c = 9 + rnd.randRange(22);
        let r = rnd.randRange(15);
        while (Map.isWall(c, r)) {
            let c = 9 + rnd.randRange(22);
            let r = rnd.randRange(15);
        }
        return (r * 32) + c;
    }

    /** Distância de Manhattan, em células, entre duas células codificadas. */
    function int distance(int cellA, int cellB) {
        return Math.abs(Map.colOf(cellA) - Map.colOf(cellB)) + Math.abs(Map.rowOf(cellA) - Map.rowOf(cellB));
    }

    /**
     * Célula livre aleatória a uma distância de Manhattan >= minDist (em células) de 'from', e
     * nunca a mesma célula. Se não achar uma em 40 tentativas, diminui minDist em 1, então
     * sempre termina.
     */
    function int randomFarCell(int from, int minDist) {
        var int cell, tries;
        if (minDist < 1) { let minDist = 1; }     // 0 permitiria a mesma célula
        let tries = 0;
        let cell = Map.randomFreeCell();
        while (Map.distance(cell, from) < minDist) {
            let tries = tries + 1;
            if ((tries > 40) & (minDist > 1)) {
                let minDist = minDist - 1;
                let tries = 0;
            }
            let cell = Map.randomFreeCell();
        }
        return cell;
    }

    /**
     * Uma semente nova para a PRÓXIMA partida, para que cada reinício tenha posições
     * diferentes: chame Map.init(seed) de novo com esse valor.
     */
    function int nextSeed() {
        return rnd.rand();
    }

    function int colOf(int cell) { return cell & 31; }
    function int rowOf(int cell) { return cell / 32; }
    function int xOf(int cell)   { return (cell & 31) * 16; }   // x em pixels, para Ghost/Person.new
    function int yOf(int cell)   { return (cell / 32) * 16; }   // y em pixels, para Ghost/Person.new
}
