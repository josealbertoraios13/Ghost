/**
 * Mapa do labirinto. Layout da tela: as colunas 0..8 (x 0..143) são o painel lateral (Hud) e
 * as colunas 9..31 (x 144..511) são a área de jogo. Células de 16x16 px, linhas 0..15 (y 0..255).
 * As células do painel contam como parede na colisão, mas nunca são desenhadas aqui (a área é do Hud).
 */
class Map {
    static Array rows;   // 16 strings de 32 caracteres: '#' = parede (código 35), '.' = livre
    static Random random;
    static boolean mapWasInitialized;

    /**
    * Prepara o mapa para uma partida. Deve ser chamado no início de cada partida,
    * com uma nova semente (veja nextMatchSeed) para variar as posições.
    * As linhas do labirinto são criadas apenas na primeira chamada e reaproveitadas
    * nas seguintes; o gerador aleatório é recriado a cada partida.
    */
    function void init(int seed) {
        
        if (mapWasInitialized) {
            do random.dispose();
        } else {
            let rows = Array.new(Constant.MAP_ROWS());

            let rows[0]  = "################################";
            let rows[1]  = "##########.#.........#.#.......#";
            let rows[2]  = "##########.#.#.###.#.#.#.#####.#";
            let rows[3]  = "##########.#.............#...#.#";
            let rows[4]  = "##########.#.###.###.#.###.#.#.#";
            let rows[5]  = "##########.....#...............#";
            let rows[6]  = "##########.#.#.#.#######.###.#.#";
            let rows[7]  = "##########.....#.............#.#";
            let rows[8]  = "############.#.#.#.###.#.###.#.#";
            let rows[9]  = "##########.......#.....#.......#";
            let rows[10] = "##########.#.#.#.###.#.#.#####.#";
            let rows[11] = "##########.#.#.#.......#.......#";
            let rows[12] = "##########...#...###.#.....#.#.#";
            let rows[13] = "##########.#####..#..#######.#.#";
            let rows[14] = "##########.....................#";
            let rows[15] = "################################";

            let mapWasInitialized = true;
        }

        let random = Random.new(seed);
        return;
    }

    /** Libera as linhas e o gerador. Normalmente não precisa: init() reaproveita as linhas. */
    function void dispose() {
        var int i;
        var String line;

        if (mapWasInitialized) {
            let i = 0;

            while (i < Constant.MAP_ROWS()) {
                let line = rows[i];
                do line.dispose();
                let i = i + 1;
            }

            do rows.dispose();
            do random.dispose();

            let mapWasInitialized = false;
        }

        return;
    }

    function boolean isWall(int col, int row) {
        var String line;

        if ((col < 0) | (col > Constant.MAP_LAST_COLUMN()) | (row < 0) | (row > Constant.MAP_LAST_ROW())) { 
            return true; 
        }

        let line = rows[row];

        return line.charAt(col) = Constant.WALL_CHAR();
    }

    /**
    * Desenha as paredes da área de jogo, da coluna MAP_PLAYABLE_START_COLUMN()
    * até MAP_LAST_COLUMN(). Deve ser chamado depois de Screen.clearScreen().
    */
    function void draw() {
        var int row, col;
        var String line;

        let row = 0;

        while (row < Constant.MAP_ROWS()) {
            let line = rows[row];
            let col = Constant.MAP_PLAYABLE_START_COLUMN();
            
            while (col < (Constant.MAP_LAST_COLUMN() + 1)) {
                if (line.charAt(col) = Constant.WALL_CHAR()) { 
                    do Map.drawWall(col, row); 
                }
                
                let col = col + 1;
            }

            let row = row + 1;
        }

        return;
    }

    function void drawWall(int col, int row) {
        var int addr, i;

        let addr = 16384 + (row * 512) + col; 
        let i = 0;
        
        while (i < Constant.SPRITE_SIZE()) {
            do Memory.poke(addr + (i * Constant.SCREEN_WIDTH_IN_WORDS()), -1);

            let i = i + 1;
        }
        
        return;
    }

    /**
     * Célula livre aleatória da área de jogo (nunca parede, nunca o painel lateral),
     * codificada como linha * (MAP_LAST_COLUMN() + 1) + coluna.
     * Use colOf(), rowOf(), xOf() e yOf() para decodificar.
     */
    function int randomFreeCell() {
        var int col, row;

        // Sorteia uma coluna da área jogável e uma linha do mapa.
        // randRange(n) inclui os dois extremos: 0 e n.
        let col = Constant.MAP_PLAYABLE_START_COLUMN() + random.randRange(Constant.MAP_PLAYABLE_MAX_OFFSET());
        let row = random.randRange(Constant.MAP_LAST_ROW());

        while (Map.isWall(col, row)) {
            let col = Constant.MAP_PLAYABLE_START_COLUMN() + random.randRange(Constant.MAP_PLAYABLE_MAX_OFFSET());
            let row = random.randRange(Constant.MAP_LAST_ROW());
        }

        return (row * (Constant.MAP_LAST_COLUMN() + 1)) + col;
    }

    function int colOf(int cell) { 
        return cell & Constant.MAP_LAST_COLUMN(); 
    }
    
    function int rowOf(int cell) { 
        return cell / (Constant.MAP_LAST_COLUMN() + 1); 
    }

    function int xOf(int cell) { 
        return Map.colOf(cell) * Constant.SPRITE_SIZE();
    }   // x em pixels, para Ghost/Person.new
    
    function int yOf(int cell) { 
        return Map.rowOf(cell) * Constant.SPRITE_SIZE(); 
    }   // y em pixels, para Ghost/Person.new
}
