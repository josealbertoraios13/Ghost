/**
 * Mapa do labirinto. Layout da tela: as colunas 0..8 (x 0..143) são o painel lateral (Hud) e
 * as colunas 9..31 (x 144..511) são a área de jogo. Células de 16x16 px, linhas 0..15 (y 0..255).
 * As células do painel contam como parede na colisão, mas nunca são desenhadas aqui (a área é do Hud).
 */
class Map {
    static Array rows;   // 16 strings de 32 caracteres: '#' = parede (código 35), '.' = livre
    static Random rnd;
    static boolean built;   // verdadeiro depois que as linhas foram criadas (elas são criadas só uma vez)

    /**
     * Vai preparar o mapa para uma partida. Chame no início de cada partida, com uma semente nova
     * (veja nextSeed) para que as posições mudem. As linhas do labirinto são criadas só na
     * Pirmeira chamada e reaproveitadas depois; o que é trocado a cada vez é o gerador aleatório.
     */
    function void init(int seed) {
<<<<<<< Updated upstream
