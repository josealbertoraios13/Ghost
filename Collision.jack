class Collision {
    function boolean checkCollisionWall(int nextX, int nextY){
        var int left, right, top, bottom, size;

        let size = Constant.SPRITE_SIZE();

        let left = nextX / size;
        let right = (nextX + size - 1) / size;  

        let top = nextY / size;
        let bottom = (nextY + size - 1) / size;

        if(Map.isWall(left, top) | Map.isWall(right, top) | Map.isWall(left, bottom) | Map.isWall(right, bottom)){
            return true;
        }

        return false;
    }

    function boolean checkCollisionPlayers(Ghost ghost, Person person){
        var boolean touchX, touchY;

        let touchX = Collision.isLessOrEqual(ghost.getLeft(), person.getRight()) & Collision.isLessOrEqual(person.getLeft(), ghost.getRight());

        let touchY = Collision.isLessOrEqual(ghost.getTop(), person.getBottom()) & Collision.isLessOrEqual(person.getTop(), ghost.getBottom());
        
        return touchX & touchY;
    }

    function boolean isLessOrEqual(int a, int b) {
        return (a < b) | (a = b);
    }
}