class Hud {
    static String timerLabel;
    
    function void init() {
        let timerLabel = "TIMER:";
        return;
    }

    function void dispose(){
        do timerLabel.dispose();
        return;
    }

    /** Desenha o texto fixo no painel lateral, no caso o título e os controles dos dois jogadores. */
    function void drawPanel() {
        do Output.moveCursor(1, 3);
        do Output.printString("-- GHOST --");

        do Output.moveCursor(15, 3);
        do Output.printString("P1 FANTASMA");
        do Output.moveCursor(16, 3);
        do Output.printString("setas: mover");
        do Output.moveCursor(17, 3);
        do Output.printString(".: parar");

        do Output.moveCursor(19, 3);
        do Output.printString("P2 PESSOA");
        do Output.moveCursor(20, 3);
        do Output.printString("WASD: mover");
        do Output.moveCursor(21, 3);
        do Output.printString("E: parar");
        return;
    }

    /** Limpa a área do relógio. O Hud.drawTimer já vai fazer isso sozinho; vai precisar apenas chamar para esconder o relógio. */
    function void clearTimer() {
        do Screen.setColor(false);
        do Screen.drawRectangle(0, 33, 127, 65);   // linhas de texto 3..5 do painel (x 0..127)
        do Screen.setColor(true);
        return;
    }

    /**
     * Desenha uma contagem regressiva no painel lateral. o rótulo (linha 3) e os segundos (linha 5),
     * ambos a partir da coluna de texto 3, alinhados com o resto do painel. Limpe a área antes viu,
     * então um número ou rótulo mais curto nunca deixa restos (10 -> 9, "Prepare-se" -> "Tempo").
     * Chame só quando 'secs' mudar (uma vez por segundo), não a cada volta do laço do jogo.
     * NÃO é para passar um texto literal aqui a cada chamada (cada chamada criaria uma String nova que
     * nunca é reaproveitada): crie o rótulo uma vez e reutilize, como o Menu faz.
     */

    function void drawTimer(String label, int secs) {
        do Hud.clearTimer();
        do Output.moveCursor(3, 3);
        do Output.printString(label);
        do Output.moveCursor(5, 3);
        do Output.printString(timerLabel);
        do Output.moveCursor(5, 10);
        do Output.printInt(secs);
        return;
    }

    /** Escreve s centralizado na área de jogo (colunas de texto 18..63 = 46 colunas), na linha de texto indicada. */
    function void printCentered(String s, int row) {
        do Output.moveCursor(row, 18 + ((46 - s.length()) / 2));
        do Output.printString(s);
        return;
    }

    /**
     * loser = 1 (jogador do fantasma) ou 2 (jogador da pessoa): quem perdeu.
     *   fantasma toca a pessoa  -> Hud.gameOver(2)
     *   o tempo acaba           -> Hud.gameOver(1)
     * Vai desenhar uma caixa com a mensagem, centralizada na área de jogo. A tela fica como está
     * depois disso: quem chamou espera (Sys.wait) e então reinicia a partida.
     */
    function void gameOver(int loser) {
        var String msg, msg2;
        if (loser = 2) { let msg = "Game Over - Fantasma Venceu!"; }
        else           { let msg = "Game Over - Pessoa Venceu!"; }
        let msg2 = "Reiniciando...";

        // caixa (borda preta, interior branco), centralizada na área de jogo (x 144..511)
        // e nas duas linhas de texto (linhas 11 e 12 = y 121..142)
        do Screen.setColor(true);
        do Screen.drawRectangle(200, 106, 455, 157);
        do Screen.setColor(false);
        do Screen.drawRectangle(204, 110, 451, 153);
        do Screen.setColor(true);

        do Hud.printCentered(msg, 11);
        do Hud.printCentered(msg2, 12);

        do msg.dispose();
        do msg2.dispose();

        return;
    }

    function void clearGameOver() {
        do Screen.setColor(false);
        do Screen.drawRectangle(200, 106, 455, 157);
        do Screen.setColor(true);
        do Map.draw();
        return;
    }
}