/**
 * Implements the Square Dance game.
 * This simple game allows the user to move a black square around
 * the screen, and change the square's size during the movement.
 * When the game starts, a square of 30 by 30 pixels is shown at the
 * top-left corner of the screen. The user controls the square as follows.
 * The 4 arrow keys are used to move the square up, down, left, and right.
 * The 'z' and 'x' keys are used, respectively, to decrement and increment
 * the square's size. The 'q' key is used to quit the game.
 */

class GhostGame {
   field boolean exit;

   field String playLabel;
   field String startLabel;

   field int playableTime;
   field int elapsedTime;

   field int ghostDirection;
   field int personDirection; // the square's current ghostDirection: 
                        // 0=none, 1=up, 2=down, 3=left, 4=right
   field Random random;

   field Menu menu;

   field Ghost ghost;
   field Person person;

   field int gX, gY, pX, pY; 
   field int cellG, cellP;

   /** Constructs a new Square Game. */
   constructor GhostGame new() {
      let menu = Menu.new();
      
      do Hud.init();
      
      let playLabel = "PLAY!";
      let startLabel = "STARTING!";

      do Map.init(19);
      do Map.draw();

      let random = Random.new(19);

      return this;
   }

   method void initPlayers(){
      let cellG = Map.randomFreeCell();
      let cellP = Map.randomFreeCell();
      
      let gX = Map.xOf(cellG);
      let gY = Map.yOf(cellG);

      let pX = Map.xOf(cellP);
      let pY = Map.yOf(cellP);

      let ghost = Ghost.new(gX, gY);
      let person = Person.new(pX, pY);

      let ghostDirection = 4;
      let personDirection = 4;
      return;
   }

   method void restart(){
      let ghostDirection = 0;
      let personDirection = 0;

      do Sys.wait(5000);

      do ghost.erase();
      do ghost.dispose();

      do person.erase();
      do person.dispose();

      do Hud.clearGameOver();

      let playableTime = 30;
      let elapsedTime = 0;

      do toStartTimer();
      do initPlayers();

      return;
   }

   /** Disposes this game. */
   method void dispose() {
      do ghost.dispose();
      do person.dispose();
      do playLabel.dispose();
      do startLabel.dispose();
      do random.dispose();
      do Hud.dispose();
      do Memory.deAlloc(this);
      return;
   }

   /** Moves the square in the current ghostDirection. */
   method void moveGhost() {
      if (ghostDirection = 1) { do ghost.moveUp(); }
      if (ghostDirection = 2) { do ghost.moveDown(); }
      if (ghostDirection = 3) { do ghost.moveLeft(); }
      if (ghostDirection = 4) { do ghost.moveRight(); }
      do Sys.wait(5);  // delays the next movement
      return;
   }

   method void movePerson() {
      if (personDirection = 1) { do person.moveUp(); }
      if (personDirection = 2) { do person.moveDown(); }
      if (personDirection = 3) { do person.moveLeft(); }
      if (personDirection = 4) { do person.moveRight(); }
      do Sys.wait(5);  // delays the next movement
      return;
   }

   method boolean onCollision(){
      var boolean touchX, touchY;

      let touchX =
         ((ghost.getLeft() < (person.getRight() + 1)) |
            (ghost.getLeft() = (person.getRight() + 1))) &
         ((person.getLeft() < (ghost.getRight() + 1)) |
            (person.getLeft() = (ghost.getRight() + 1)));

      let touchY =
         ((ghost.getTop() < (person.getBottom() + 1)) |
            (ghost.getTop() = (person.getBottom() + 1))) &
         ((person.getTop() < (ghost.getBottom() + 1)) |
            (person.getTop() = (ghost.getBottom() + 1)));
         return touchX & touchY;
   }

   /** Runs the game: handles the user's inputs and moves the square accordingly */
   method void run() {
      var char key;  // the key currently pressed by the user
      var int startTime;
      var int currentTime;

      let exit = false;
      let playableTime = 30;
      let elapsedTime = 0;

      do toStartTimer();

      do initPlayers();

      while (~exit) {

         let key = Keyboard.keyPressed();

         if (key = 140) {
            let exit = true;
         }

         do Hud.drawTimer(playLabel, playableTime);

         do ghostInputs(key);
         do personInputs(key);

         do moveGhost();
         do movePerson();

         if (onCollision()) {
            let ghostDirection = 0;
            let personDirection = 0;
            do Hud.gameOver(2);
            do restart();
         }

         do Sys.wait(10);

         let elapsedTime = elapsedTime + 100;

         if (elapsedTime = 1000 | elapsedTime > 1000) {
            let elapsedTime = 0;
            let playableTime = playableTime - 1;
         }

         if (playableTime = 0) {
            let ghostDirection = 0;
            let personDirection = 0;
            do Hud.gameOver(1);
            do restart();
         }
      }

      return;
   }

   method void personInputs(char key){
      if ((key = 87) | (key = 119)) { let personDirection = 1; }  // W/w
      if ((key = 83) | (key = 115)) { let personDirection = 2; }  // S/s
      if ((key = 65) | (key = 97))  { let personDirection = 3; }  // A/a
      if ((key = 68) | (key = 100)) { let personDirection = 4; }  // D/d

      if ((key = 69) | (key = 101)) { let personDirection = 0; }  // E/e to stop
      
      return;
   }

   method void ghostInputs(char key){
      if (key = 131) { let ghostDirection = 1; }   // up
      if (key = 133) { let ghostDirection = 2; }   // down
      if (key = 130) { let ghostDirection = 3; }   // left
      if (key = 132) { let ghostDirection = 4; }   // right

      if (key = 46) { let ghostDirection = 0; }   // . to stop

      return;
   }

   method void toStartTimer(){
      var int seconds;

      let seconds = 3;

      while (seconds > 0) {
         do Hud.drawTimer(startLabel, seconds);
         do Sys.wait(1000);
         let seconds = seconds - 1;
      }

      do Hud.drawTimer(startLabel, 0);

      return;
   }
}